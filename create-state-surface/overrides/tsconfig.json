{
  "compilerOptions": {
    "target": "ES2022",
    "module": "ESNext",
    "moduleResolution": "bundler",
    "esModuleInterop": true,
    "strict": true,
    "skipLibCheck": true,
    "outDir": "dist",
    "rootDir": ".",
    "jsx": "react-jsx",
    "jsxImportSource": "lithent",
    "types": ["node"]
  },
  "include": [
    "server.ts",
    "client",
    "shared",
    "routes",
    "transitions",
    "layouts",
    "testing",
    ".state-surface/*.d.ts"
  ],
  "exclude": ["node_modules", "dist"]
}
