{
  "compilerOptions": {
    "target": "ES2022",
    "module": "ESNext",
    "moduleResolution": "bundler",
    "esModuleInterop": true,
    "strict": true,
    "skipLibCheck": true,
    "noEmit": true,
    "jsx": "react-jsx",
    "jsxImportSource": "lithent",
    "types": ["node"]
  },
  "include": ["**/*.ts", "**/*.tsx", ".state-surface/*.ts"],
  "exclude": ["node_modules", "dist"]
}
