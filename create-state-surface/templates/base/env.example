# Server
PORT=3000

# Mount app under a sub-path (leave empty for root)
# BASE_PATH=/demo

# Public origin when a proxy terminates TLS (nginx, a load balancer): POST requests are checked
# against it, so actions answer 403 without it. Leave unset when the app serves the public URL
# itself (and on Cloudflare Workers).
# ORIGIN=https://example.com

# Root secret (32+ bytes) for deferred slot tokens and flash cookies. Each build makes its own
# when unset: set the same value on every instance when servers build separately.
# SURFACE_SECRET=
