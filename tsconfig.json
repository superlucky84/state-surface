{
  "compilerOptions": {
    "target": "ES2022",
    "module": "ESNext",
    "moduleResolution": "bundler",
    "esModuleInterop": true,
    "strict": true,
    "skipLibCheck": true,
    "outDir": "dist",
    "rootDir": ".",
    "jsx": "react-jsx",
    "jsxImportSource": "lithent",
    "types": ["node"],
    "baseUrl": ".",
    "paths": {
      "state-surface": ["./engine/index.ts"],
      "state-surface/server": ["./engine/server.ts"],
      "state-surface/client": ["./engine/client.ts"],
      "state-surface/adapters/*": ["./engine/adapters/*.ts"],
      "state-surface/vite": ["./engine/vite.ts"],
      "state-surface/internal/assets": ["./engine/server/assets.ts"],
      "state-surface/internal/basePath": ["./engine/shared/basePath.ts"],
      "state-surface/internal/island": ["./engine/island.ts"],
      "state-surface/server-only": ["./engine/serverOnly.ts"]
    }
  },
  "include": ["engine", "server.ts", "client", "shared", "routes", "layouts", "testing"],
  "exclude": ["node_modules", "dist"]
}
