{
  "name": "state-surface",
  "version": "0.1.0",
  "description": "A state-layout mapping runtime for MPA pages with NDJSON streaming updates",
  "type": "module",
  "types": "./engine/index.ts",
  "exports": {
    ".": "./engine/index.ts",
    "./server": "./engine/server.ts",
    "./client": "./engine/client.ts",
    "./vite": "./engine/vite.ts",
    "./rich": "./engine/rich.ts",
    "./adapters/*": "./engine/adapters/*.ts",
    "./internal/assets": "./engine/server/assets.ts",
    "./internal/basePath": "./engine/shared/basePath.ts",
    "./internal/island": "./engine/island.ts",
    "./internal/prerender": "./engine/server/prerenderEntry.ts",
    "./server-only": {
      "browser": "./engine/serverOnly.browser.ts",
      "default": "./engine/serverOnly.ts"
    }
  },
  "files": [
    "engine/**/*.ts",
    "!engine/**/*.test.ts",
    "README.md",
    "LICENSE"
  ],
  "publishConfig": {
    "access": "public"
  },
  "license": "MIT",
  "keywords": [
    "state-surface",
    "mpa",
    "ndjson",
    "streaming",
    "ssr",
    "server-driven-ui",
    "state-management",
    "hydration",
    "real-time"
  ],
  "repository": {
    "type": "git",
    "url": "https://github.com/superlucky84/state-surface.git"
  },
  "homepage": "https://github.com/superlucky84/state-surface#readme",
  "bugs": {
    "url": "https://github.com/superlucky84/state-surface/issues"
  },
  "engines": {
    "node": ">=20"
  },
  "packageManager": "pnpm@10.13.1",
  "scripts": {
    "dev": "vite --host 0.0.0.0 --port 3000",
    "build": "vite build && vite build --ssr server.ts --outDir dist --emptyOutDir false && node scripts/build-scaffold.mjs",
    "start": "NODE_ENV=production node dist/server.js",
    "test": "vitest run",
    "format": "prettier --write 'engine/**/*.ts' 'client/**/*.ts' 'shared/**/*.ts' 'routes/**/*.ts' 'routes/**/*.tsx' 'transitions/**/*.ts' 'layouts/**/*.tsx' 'e2e/**/*.ts' 'e2e/**/*.tsx' 'e2e/**/*.mjs' 'perf/*.mjs' 'playwright.config.ts' 'conformance/**/*.ts' 'conformance/*.mjs' 'vite.config.ts' 'testing/**/*.ts'",
    "format:check": "prettier --check 'engine/**/*.ts' 'client/**/*.ts' 'shared/**/*.ts' 'routes/**/*.ts' 'routes/**/*.tsx' 'transitions/**/*.ts' 'layouts/**/*.tsx' 'e2e/**/*.ts' 'e2e/**/*.tsx' 'e2e/**/*.mjs' 'perf/*.mjs' 'playwright.config.ts' 'conformance/**/*.ts' 'conformance/*.mjs' 'vite.config.ts' 'testing/**/*.ts'",
    "build:scaffold": "node scripts/build-scaffold.mjs",
    "test:e2e": "playwright test",
    "perf": "node perf/measure.mjs",
    "perf:compare": "node perf/compare.mjs",
    "test:spikes": "playwright test --project=spikes",
    "build:conformance": "node conformance/build.mjs",
    "test:conformance": "node conformance/run.mjs",
    "check:core": "node conformance/guard.mjs",
    "test:parity": "node conformance/parity.mjs",
    "typecheck:server": "tsc -p tsconfig.server.json",
    "build:adapter-app": "tsx conformance/app-build.ts",
    "test:modes": "node e2e/modes/build.mjs && playwright test -c e2e/modes/playwright.config.ts"
  },
  "pnpm": {
    "onlyBuiltDependencies": [
      "esbuild"
    ]
  },
  "devDependencies": {
    "@playwright/test": "1.56.1",
    "@tailwindcss/vite": "^4.1.18",
    "@types/express": "^5.0.6",
    "@types/hast": "3.0.4",
    "@types/mdast": "4.0.4",
    "@types/node": "^25.2.1",
    "@types/prismjs": "^1.26.6",
    "@types/supertest": "^6.0.3",
    "ctxbin": "^1.3.1",
    "express": "^5.2.1",
    "happy-dom": "^20.5.0",
    "idiomorph": "0.7.4",
    "prettier": "^3.8.1",
    "supertest": "^7.2.2",
    "tailwindcss": "^4.1.18",
    "tsx": "^4.21.0",
    "typescript": "^5.9.3",
    "vite": "^7.3.1",
    "vitest": "^4.0.18",
    "wrangler": "4.151.0"
  },
  "dependencies": {
    "@mdx-js/mdx": "3.1.1",
    "lithent": "^1.25.1",
    "magic-string": "^0.30.21",
    "mdast-util-directive": "3.1.0",
    "mdast-util-from-markdown": "2.0.3",
    "mdast-util-frontmatter": "2.0.1",
    "mdast-util-to-hast": "13.2.1",
    "micromark-extension-directive": "4.0.0",
    "micromark-extension-frontmatter": "2.0.0",
    "oxc-parser": "0.94.0",
    "prismjs": "^1.30.0",
    "yaml": "2.8.1"
  },
  "peerDependencies": {
    "express": "^5.2.1"
  },
  "peerDependenciesMeta": {
    "express": {
      "optional": true
    }
  }
}
