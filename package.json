{
  "name": "state-surface",
  "version": "0.1.0",
  "description": "A state-layout mapping runtime for MPA pages with NDJSON streaming updates",
  "type": "module",
  "types": "./lib/index.d.ts",
  "bin": {
    "state-surface": "./lib/cli.js"
  },
  "exports": {
    ".": {
      "state-surface-source": "./engine/index.ts",
      "types": "./lib/index.d.ts",
      "default": "./lib/index.js"
    },
    "./server": {
      "state-surface-source": "./engine/server.ts",
      "types": "./lib/server.d.ts",
      "default": "./lib/server.js"
    },
    "./client": {
      "state-surface-source": "./engine/client.ts",
      "types": "./lib/client.d.ts",
      "default": "./lib/client.js"
    },
    "./vite": {
      "state-surface-source": "./engine/vite.ts",
      "types": "./lib/vite.d.ts",
      "default": "./lib/vite.js"
    },
    "./rich": {
      "state-surface-source": "./engine/rich.ts",
      "types": "./lib/rich.d.ts",
      "default": "./lib/rich.js"
    },
    "./content": {
      "state-surface-source": "./engine/content.ts",
      "types": "./lib/content.d.ts",
      "default": "./lib/content.js"
    },
    "./adapters/*": {
      "state-surface-source": "./engine/adapters/*.ts",
      "types": "./lib/adapters/*.d.ts",
      "default": "./lib/adapters/*.js"
    },
    "./internal/assets": {
      "state-surface-source": "./engine/server/assets.ts",
      "types": "./lib/server/assets.d.ts",
      "default": "./lib/server/assets.js"
    },
    "./internal/basePath": {
      "state-surface-source": "./engine/shared/basePath.ts",
      "types": "./lib/shared/basePath.d.ts",
      "default": "./lib/shared/basePath.js"
    },
    "./internal/images": {
      "state-surface-source": "./engine/shared/image.ts",
      "types": "./lib/shared/image.d.ts",
      "default": "./lib/shared/image.js"
    },
    "./internal/island": {
      "state-surface-source": "./engine/island.ts",
      "types": "./lib/island.d.ts",
      "default": "./lib/island.js"
    },
    "./internal/prerender": {
      "state-surface-source": "./engine/server/prerenderEntry.ts",
      "types": "./lib/server/prerenderEntry.d.ts",
      "default": "./lib/server/prerenderEntry.js"
    },
    "./server-only": {
      "state-surface-source": {
        "browser": "./engine/serverOnly.browser.ts",
        "default": "./engine/serverOnly.ts"
      },
      "browser": {
        "types": "./lib/serverOnly.browser.d.ts",
        "default": "./lib/serverOnly.browser.js"
      },
      "default": {
        "types": "./lib/serverOnly.d.ts",
        "default": "./lib/serverOnly.js"
      }
    }
  },
  "files": [
    "lib",
    "README.md",
    "LICENSE"
  ],
  "publishConfig": {
    "access": "public"
  },
  "license": "MIT",
  "keywords": [
    "state-surface",
    "mpa",
    "ndjson",
    "streaming",
    "ssr",
    "server-driven-ui",
    "state-management",
    "hydration",
    "real-time"
  ],
  "repository": {
    "type": "git",
    "url": "https://github.com/superlucky84/state-surface.git"
  },
  "homepage": "https://github.com/superlucky84/state-surface#readme",
  "bugs": {
    "url": "https://github.com/superlucky84/state-surface/issues"
  },
  "engines": {
    "node": ">=20"
  },
  "packageManager": "pnpm@10.13.1",
  "scripts": {
    "dev": "vite --host 0.0.0.0 --port 3000",
    "build": "vite build && vite build --ssr server.ts --outDir dist --emptyOutDir false",
    "start": "NODE_ENV=production node dist/server.js",
    "test": "vitest run",
    "format": "prettier --write 'engine/**/*.{ts,tsx}' 'client/**/*.ts' 'shared/**/*.ts' 'routes/**/*.{ts,tsx}' 'transitions/**/*.ts' 'layouts/**/*.tsx' 'content/**/*.{ts,yaml}' 'e2e/**/*.{ts,tsx,mjs}' 'perf/*.mjs' 'scripts/*.mjs' 'playwright.config.ts' 'conformance/**/*.ts' 'conformance/*.mjs' 'vite.config.ts' 'vitest.config.ts' 'testing/**/*.ts' 'create-state-surface/**/*.{js,ts,tsx,json}'",
    "format:check": "prettier --check 'engine/**/*.{ts,tsx}' 'client/**/*.ts' 'shared/**/*.ts' 'routes/**/*.{ts,tsx}' 'transitions/**/*.ts' 'layouts/**/*.tsx' 'content/**/*.{ts,yaml}' 'e2e/**/*.{ts,tsx,mjs}' 'perf/*.mjs' 'scripts/*.mjs' 'playwright.config.ts' 'conformance/**/*.ts' 'conformance/*.mjs' 'vite.config.ts' 'vitest.config.ts' 'testing/**/*.ts' 'create-state-surface/**/*.{js,ts,tsx,json}'",
    "test:e2e": "playwright test",
    "perf": "node perf/measure.mjs",
    "perf:compare": "node perf/compare.mjs",
    "perf:gate": "node perf/gate.mjs",
    "perf:report": "node perf/report.mjs",
    "test:spikes": "playwright test --project=spikes",
    "build:conformance": "node conformance/build.mjs",
    "test:conformance": "node conformance/run.mjs",
    "test:conformance:app": "node conformance/app.mjs",
    "check:core": "node conformance/guard.mjs",
    "check": "tsx engine/cli.ts check",
    "test:scaffold": "node scripts/scaffold-test.mjs",
    "test:parity": "node conformance/parity.mjs",
    "typecheck:server": "tsc -p tsconfig.server.json",
    "build:adapter-app": "tsx conformance/app-build.ts",
    "test:adapters": "node e2e/adapters/run.mjs",
    "test:modes": "node e2e/modes/build.mjs && playwright test -c e2e/modes/playwright.config.ts",
    "test:sdk": "node e2e/sdk/build.mjs && playwright test -c e2e/sdk/playwright.config.ts",
    "build:package": "node scripts/build-package.mjs",
    "prepack": "node scripts/build-package.mjs"
  },
  "pnpm": {
    "onlyBuiltDependencies": [
      "esbuild"
    ]
  },
  "devDependencies": {
    "@datadog/browser-rum": "7.16.0",
    "@playwright/test": "1.56.1",
    "@sentry/browser": "11.8.0",
    "@tailwindcss/vite": "^4.1.18",
    "@types/express": "^5.0.6",
    "@types/hast": "3.0.4",
    "@types/mdast": "4.0.4",
    "@types/node": "^25.2.1",
    "@types/prismjs": "^1.26.6",
    "@types/supertest": "^6.0.3",
    "ctxbin": "^1.3.1",
    "express": "^5.2.1",
    "happy-dom": "^20.5.0",
    "prettier": "^3.8.1",
    "supertest": "^7.2.2",
    "tailwindcss": "^4.1.18",
    "tsx": "^4.21.0",
    "typescript": "^5.9.3",
    "vite": "^7.3.1",
    "vitest": "^4.0.18",
    "wrangler": "4.151.0"
  },
  "dependencies": {
    "@mdx-js/mdx": "3.1.1",
    "idiomorph": "0.7.4",
    "lithent": "^1.25.2",
    "magic-string": "^0.30.21",
    "mdast-util-directive": "3.1.0",
    "mdast-util-from-markdown": "2.0.3",
    "mdast-util-frontmatter": "2.0.1",
    "mdast-util-to-hast": "13.2.1",
    "micromark-extension-directive": "4.0.0",
    "micromark-extension-frontmatter": "2.0.0",
    "oxc-parser": "0.94.0",
    "prismjs": "^1.30.0",
    "sharp": "0.35.5",
    "source-map": "0.7.6",
    "yaml": "2.8.1"
  },
  "peerDependencies": {
    "express": "^5.2.1",
    "vite": "^7.3.1"
  },
  "peerDependenciesMeta": {
    "express": {
      "optional": true
    }
  }
}
